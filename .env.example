# Copiar como .env y completar con valores reales antes de levantar el proyecto.

# MySQL
DB_HOST=mysql
DB_PORT=3306
DB_NAME=demo_db
DB_USER=demo
DB_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me

# JWT
JWT_SECRET=change-me-min-32-characters
JWT_EXPIRATION_MS=3600000

# Admin semilla (se crea automaticamente al levantar el back)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
