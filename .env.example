# Copiar como .env y completar con valores reales antes de levantar el proyecto.

# MySQL
DB_HOST=mysql
DB_PORT=3306
DB_NAME=demo_db
DB_USER=demo
DB_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me

# JWT
JWT_SECRET=change-me-min-32-characters
JWT_EXPIRATION_MS=3600000

# Desarrollo local con Live Server (separar los valores por comas)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500

# Admin semilla (se crea automaticamente al levantar el back)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
